[Unit]
Description=TimeMachine Observation Chamber Service
Documentation=https://github.com/yourusername/timemachine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=timemachine
Group=timemachine
WorkingDirectory=/opt/timemachine/backend

# Environment
EnvironmentFile=/etc/timemachine/timemachine.env

# Resource Limits (Pi 3 constraints)
MemoryMax=800M
MemoryHigh=700M
CPUQuota=300%
TasksMax=256

# Security Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/timemachine /var/log/timemachine
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true

# Device Access (for cameras)
DevicePolicy=closed
DeviceAllow=/dev/video* rw
DeviceAllow=/dev/vchiq rw
DeviceAllow=/dev/vcsm-cma rw

# Execution
ExecStart=/opt/timemachine/venv/bin/uvicorn app.main:app \
    --host ${TIMEMACHINE_HOST} \
    --port ${TIMEMACHINE_PORT} \
    --workers 1 \
    --log-config /etc/timemachine/logging.json
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Standard output to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=timemachine

[Install]
WantedBy=multi-user.target
